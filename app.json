{
  "expo": {
    "name": "LifeOS",
    "slug": "lifeos",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifeos",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.lifeos.personal"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#18181B"
      },
      "package": "app.lifeos.personal",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F4F5"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#18181B",
          "defaultChannel": "lifeos-reminders-v3",
          "sounds": ["./assets/sounds/lifeos_reminder.wav"]
        }
      ],
      "expo-status-bar",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Fraunces_600SemiBold.ttf",
            "./assets/fonts/IBMPlexMono_400Regular.ttf",
            "./assets/fonts/Figtree_600SemiBold.ttf",
            "./assets/fonts/Figtree_500Medium.ttf",
            "./assets/fonts/Figtree_400Regular.ttf"
          ],
          "widgets": [
            {
              "name": "Spend",
              "label": "LifeOS · Spend",
              "description": "Current month spend with category tape",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Renewals",
              "label": "LifeOS · Coming up",
              "description": "Next subscription renewals",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Reminders",
              "label": "LifeOS · Reminders",
              "description": "Next reminders from TickTick",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Glance",
              "label": "LifeOS · Glance",
              "description": "Spend, renewals and reminders at a glance",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
